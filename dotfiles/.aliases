# macOS
alias afk="open -a ScreenSaverEngine"

# IP addresses
alias ip="dig -4 +short myip.opendns.com @resolver1.opendns.com"
# Address of the interface of the default route (en0 isn't Wi-Fi on every Mac)
alias localip='ipconfig getifaddr "$(route -n get default | awk "/interface:/ { print \$2 }")"'

# Date/Time
alias timer="echo 'Timer started. Stop with Ctrl-D.' && date && time cat && date"
alias timestamp="date +%Y%m%d%H%M%S"
alias week='date +%V'

# Local configuration
[[ -f $HOME/.aliases.local ]] && source $HOME/.aliases.local
