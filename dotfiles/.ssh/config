# Machine-specific hosts and overrides. ssh uses the first value it finds for
# an option, so the local file comes first and wins over the defaults below.
Include ~/.ssh/config.local

Host *
  # Use the SSH keys stored in 1Password,
  # see https://developer.1password.com/docs/ssh/get-started
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  # Notice dead connections after about 3 minutes instead of hanging, and keep
  # idle ones from being dropped by NAT routers and firewalls.
  ServerAliveInterval 60
