[user]
  name = Fionn Masuhr
  email = (none)
[core]
  excludesfile = ~/.gitignore_global
[init]
  defaultBranch = main
[fetch]
  prune = true
  pruneTags = true
[pull]
  ff = only
[push]
  autoSetupRemote = true
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[merge]
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = default
[rerere]
  enabled = true
[commit]
  verbose = true
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[column]
  ui = auto
[help]
  autocorrect = prompt

[include]
  path = ~/.gitconfig.local
